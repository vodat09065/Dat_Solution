@model CMS.Data.Entities.CategoryProduct
@{
    ViewData["Title"] = "Sửa Danh mục Sản phẩm";
}

<h2 class="text-primary mb-4">Sửa Danh mục Sản phẩm</h2>

<form asp-action="Edit" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label fw-bold">Tên danh mục</label>
                <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CategoryId" class="form-label fw-bold">Danh mục cha</label>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryList">
                    <option value="">-- Chọn danh mục cha --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Hình ảnh hiện tại</label>
                    <div>
                        <img src="@Model.ImageUrl" style="max-width: 200px; max-height: 200px; border-radius: 5px; border: 1px solid #ddd;" />
                    </div>
                    <small class="text-muted">Chọn ảnh mới nếu muốn thay đổi</small>
                </div>
            }

            <div class="form-group mb-3">
                <label class="form-label fw-bold">Đổi ảnh mới</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
                <small class="text-muted">Để trống nếu không muốn thay đổi ảnh</small>
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label fw-bold">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Nhập mô tả danh mục"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> Lưu thay đổi
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</form>

    }
