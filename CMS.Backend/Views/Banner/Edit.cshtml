@model CMS.Data.Entities.Banner

@{
    ViewData["Title"] = "Chỉnh sửa Banner";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Chỉnh sửa Banner</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <form asp-action="Edit" enctype="multipart/form-data" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />
                <input type="hidden" asp-for="CreatedDate" />

                <div class="form-group">
                    <label class="control-label">Tiêu đề</label>
                    <input asp-for="Title" class="form-control" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label class="control-label">Mô tả ngắn</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="control-label">Link chuyển hướng (URL)</label>
                    <input asp-for="TargetUrl" class="form-control" />
                    <span asp-validation-for="TargetUrl" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="control-label">Hình ảnh hiện tại</label>
                    <div>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="Hình ảnh" style="max-height: 150px; border-radius: 8px; margin-bottom: 10px;" />
                        }
                    </div>
                    <label class="control-label mt-2">Đổi hình ảnh mới (bỏ trống nếu giữ nguyên)</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                </div>
                
                <div class="form-group">
                    <label class="control-label">Thứ tự hiển thị (Sort Order)</label>
                    <input asp-for="SortOrder" type="number" class="form-control" />
                </div>
                
                <div class="form-group form-check">
                    <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                    <label class="form-check-label">Cho phép hiển thị</label>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Lưu lại</button>
                    <a href="/Banner/Index" class="btn btn-secondary">Trở về</a>
                </div>
            </form>
        </div>
    </div>
</div>
