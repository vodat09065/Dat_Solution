@model IEnumerable<CMS.Data.Entities.Banner>

@{
    ViewData["Title"] = "Quản lý Banner";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Danh sách Banner</h1>
        <a href="/Banner/Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Thêm mới
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Hình ảnh</th>
                            <th>Tiêu đề</th>
                            <th>Đường dẫn</th>
                            <th>Sắp xếp</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@item.ImageUrl" alt="@item.Title" style="height: 60px; object-fit: cover; border-radius: 4px;" />
                                </td>
                                <td>@item.Title</td>
                                <td>@item.TargetUrl</td>
                                <td>@item.SortOrder</td>
                                <td>
                                    <a href="/Banner/ToggleStatus/@item.Id" class="badge @(item.IsActive ? "badge-success" : "badge-secondary")">
                                        @(item.IsActive ? "Đang hiện" : "Đã ẩn")
                                    </a>
                                </td>
                                <td>
                                    <a href="/Banner/Edit/@item.Id" class="btn btn-sm btn-info">Sửa</a>
                                    <a href="/Banner/Delete/@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa banner này?');">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
