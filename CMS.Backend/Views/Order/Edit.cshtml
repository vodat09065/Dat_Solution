@model CMS.Data.Entities.Order
@{
    ViewData["Title"] = "Edit Order";
    Layout = "_LayoutAdmin";
}
<h2 class="mt-4 mb-3">Edit Order</h2>
<form asp-action="Edit" method="post" class="needs-validation" novalidate>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label class="form-label" asp-for="OrderDate">Order Date</label>
        <input class="form-control" asp-for="OrderDate" type="datetime-local" required />
        <div class="invalid-feedback">Please provide an order date.</div>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="CustomerId">Customer</label>
        <input class="form-control" asp-for="CustomerId" required />
        <div class="invalid-feedback">Please provide a customer ID.</div>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Status">Status</label>
        <input class="form-control" asp-for="Status" required />
        <div class="invalid-feedback">Please provide status.</div>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Notes">Notes</label>
        <textarea class="form-control" asp-for="Notes" rows="3"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
</form>
<script>
    (function () {
        'use strict'
        var forms = document.querySelectorAll('.needs-validation')
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault()
                    event.stopPropagation()
                }
                form.classList.add('was-validated')
            }, false)
        })
    })()
</script>
