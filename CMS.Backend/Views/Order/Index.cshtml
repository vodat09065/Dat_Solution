@model IEnumerable<CMS.Data.Entities.Order>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Order List";
}
<h2 class="mt-4 mb-3">Order List</h2>
<a class="btn btn-success mb-3" asp-action="Create">Add New Order</a>
<table class="table table-hover table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Order Date</th>
            <th>Customer ID</th>
            <th>Status</th>
            <th>Notes</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>@item.Id</td>
                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.CustomerId</td>
                <td>@(item.Status == 0 ? "Chờ duyệt" : item.Status == 1 ? "Đã duyệt" : item.Status.ToString())</td>
                <td>@item.Notes</td>
                <td>
                    @if(item.Status == 0)
                    {
                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-success">Duyệt</button>
                        </form>
                    }
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id" onclick="return confirm('Are you sure?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
