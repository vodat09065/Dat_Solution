@* Admin Layout *@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DatCMS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #1a252f; /* Dark background matching screenshots */
            color: #d1d5db;
            z-index: 1000;
            padding-top: 20px;
        }
        .sidebar .brand {
            font-size: 1.25rem;
            font-weight: bold;
            color: #ffffff;
            padding: 10px 20px;
            margin-bottom: 20px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .sidebar .user-panel {
            padding: 15px 20px;
            background-color: #121a21;
            border-bottom: 1px solid #2c3e50;
            margin-bottom: 20px;
        }
        .sidebar .user-panel h6 {
            color: #ffffff;
            margin-bottom: 2px;
            font-weight: 500;
        }
        .sidebar .user-panel small {
            color: #95a5a6;
            display: block;
            margin-bottom: 10px;
        }
        .sidebar .user-panel .btn-logout {
            background-color: #c0392b;
            color: #ffffff;
            border: none;
            padding: 4px 12px;
            font-size: 0.8rem;
            border-radius: 4px;
            text-decoration: none;
            display: inline-block;
            transition: background-color 0.2s;
        }
        .sidebar .user-panel .btn-logout:hover {
            background-color: #a93226;
            color: #ffffff;
        }
        .sidebar .nav-item {
            margin: 2px 10px;
        }
        .sidebar .nav-link {
            color: #b8c7ce;
            padding: 10px 15px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            transition: all 0.2s;
            text-decoration: none;
        }
        .sidebar .nav-link:hover {
            background-color: #2c3e50;
            color: #ffffff;
        }
        .sidebar .nav-link.active {
            background-color: #34495e;
            color: #ffffff;
            font-weight: 500;
        }
        .main-content {
            margin-left: 250px;
            padding: 30px;
            min-height: 100vh;
        }
    </style>
</head>
<body>
    <div class="sidebar d-flex flex-column">
        <div class="brand">
            DatCMS Admin
        </div>
        <div class="user-panel text-center">
            @if (User.Identity.IsAuthenticated)
            {
                <h6>Chào, @(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</h6>
                <small>(@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User"))</small>
                <a href="/Account/Logout" class="btn-logout">Đăng xuất</a>
            }
            else
            {
                <h6>Chưa đăng nhập</h6>
                <a href="/Account/Login" class="btn btn-primary btn-sm mt-2">Đăng nhập</a>
            }
        </div>
        <ul class="nav flex-column mb-auto">
            <li class="nav-item">
                <a href="/Home/Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <i class="bi bi-speedometer2 me-2"></i>Bảng điều khiển
                </a>
            </li>
            <li class="nav-item">
                <a href="/Category/Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")">
                    <i class="bi bi-grid-fill me-2"></i>Quản lý Danh mục
                </a>
            </li>
            <li class="nav-item">
                <a href="/Post/Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Post" ? "active" : "")">
                    <i class="bi bi-file-earmark-text-fill me-2"></i>Quản lý Bài viết
                </a>
            </li>
            <li class="nav-item">
                <a href="/User/Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")">
                    <i class="bi bi-people-fill me-2"></i>Quản lý Thành viên
                </a>
            </li>
            
            <li class="nav-item border-top border-secondary my-2 pt-2"></li>
            
            <li class="nav-item">
                <a href="/Product/Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")">
                    <i class="bi bi-bag-fill me-2"></i>Quản lý Sản phẩm
                </a>
            </li>
            <li class="nav-item">
                <a href="/CategoryProduct/Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CategoryProduct" ? "active" : "")">
                    <i class="bi bi-tags-fill me-2"></i>Danh mục SP
                </a>
            </li>
            <li class="nav-item">
                <a href="/Customer/Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customer" ? "active" : "")">
                    <i class="bi bi-person-badge-fill me-2"></i>Quản lý Khách hàng
                </a>
            </li>
            <li class="nav-item">
                <a href="/Order/Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")">
                    <i class="bi bi-cart-fill me-2"></i>Quản lý Đơn hàng
                </a>
            </li>
        </ul>
    </div>
    <div class="main-content">
        @RenderBody()
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
