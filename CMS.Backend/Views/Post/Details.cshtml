@{
    ViewData["Title"] = "Chi tiết Bài viết";
    Layout = "_LayoutAdmin";
}
<h2 class="text-primary">Chi tiết Bài viết</h2>
<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Title</h4>
        <p class="card-text"><strong>Danh mục:</strong> @Model.Category.Name</p>
        <p class="card-text"><strong>Nội dung:</strong> @Model.Content</p>
        @if (!string.IsNullOrEmpty(Model.ImageUrl)) {
            <img src="@Model.ImageUrl" alt="Image" class="img-fluid mt-3" />
        }
        <p class="text-muted mt-2">Ngày tạo: @Model.CreatedDate.ToString("dd/MM/yyyy")</p>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Quay lại</a>
    </div>
</div>
