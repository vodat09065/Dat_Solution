@model CMS.Data.Entities.Post
@{
    ViewData["Title"] = "Thêm mới bài viết";
    Layout = "_LayoutAdmin";
}
<h2 class="mt-4 mb-3">Thêm mới bài viết</h2>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
    <div class="mb-3">
        <label class="form-label">Tiêu đề</label>
        <input class="form-control" asp-for="Title" required />
        <div class="invalid-feedback">Vui lòng nhập tiêu đề bài viết.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Nội dung</label>
        <textarea class="form-control" asp-for="Content" rows="10" required></textarea>
        <div class="invalid-feedback">Vui lòng nhập nội dung bài viết.</div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Danh mục</label>
            <select class="form-select" asp-for="CategoryId" asp-items="ViewBag.CategoryList" required>
                <option value="">-- Chọn danh mục --</option>
            </select>
            <div class="invalid-feedback">Vui lòng chọn danh mục.</div>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Ngày đăng</label>
            <input class="form-control" asp-for="CreatedDate" type="date" required />
            <div class="invalid-feedback">Vui lòng chọn ngày đăng.</div>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Hình ảnh bài viết</label>
        <input class="form-control" type="file" name="uploadImage" accept="image/*" />
        <div class="form-text">Hoặc nhập URL hình ảnh trực tiếp:</div>
        <input class="form-control mt-2" asp-for="ImageUrl" placeholder="https://example.com/image.jpg" />
    </div>
    <button type="submit" class="btn btn-success">Đăng bài viết</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
</form>
<script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
<script>
    (function () {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                // Update CKEditor instances before validation
                for (var instanceName in CKEDITOR.instances) {
                    CKEDITOR.instances[instanceName].updateElement();
                }

                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });

        // Set default date to today
        var dateInput = document.querySelector('input[name="CreatedDate"]');
        if (dateInput && !dateInput.value) {
            dateInput.value = new Date().toISOString().split('T')[0];
        }

        // Initialize CKEditor
        CKEDITOR.replace('Content');
    })();
</script>
