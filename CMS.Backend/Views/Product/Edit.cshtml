@model CMS.Data.Entities.Product
@{
    ViewData["Title"] = "Sửa sản phẩm";
    Layout = "_LayoutAdmin";
}
<h2 class="mt-4 mb-3">Sửa sản phẩm</h2>
<form asp-action="Edit" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label class="form-label">Tên sản phẩm</label>
        <input class="form-control" asp-for="Name" required />
        <input type="hidden" asp-for="CreatedDate" />
        <div class="invalid-feedback">Vui lòng nhập tên sản phẩm.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Mô tả</label>
        <textarea class="form-control" asp-for="Description" rows="3"></textarea>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Giá (VND)</label>
            <input class="form-control" asp-for="Price" type="number" step="1000" min="0" required />
            <div class="invalid-feedback">Vui lòng nhập giá sản phẩm.</div>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Số lượng tồn kho</label>
            <input class="form-control" asp-for="StockQuantity" type="number" min="0" required />
            <div class="invalid-feedback">Vui lòng nhập số lượng.</div>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Danh mục sản phẩm</label>
        <select class="form-select" asp-for="CategoryProductId" asp-items="ViewBag.CategoryProductList" required>
            <option value="">-- Chọn danh mục --</option>
        </select>
        <div class="invalid-feedback">Vui lòng chọn danh mục.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Ngày cập nhật hàng (Quyết định thứ tự trang chủ)</label>
        <input class="form-control" asp-for="UpdatedDate" type="datetime-local" value="@(Model.UpdatedDate.HasValue ? Model.UpdatedDate.Value.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))" />
        <div class="form-text">Bạn có thể đổi sang ngày khác để sản phẩm lên hoặc xuống trong danh sách mới nhất.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Hình ảnh sản phẩm</label>
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="mb-2">
                <img src="@Model.ImageUrl" alt="@Model.Name" style="height:120px; border-radius:6px;" />
                <div class="form-text">Ảnh hiện tại. Tải ảnh mới để thay thế.</div>
            </div>
        }
        <input class="form-control" type="file" name="uploadImage" accept="image/*" />
        <div class="form-text">Hoặc nhập URL hình ảnh trực tiếp:</div>
        <input class="form-control mt-2" asp-for="ImageUrl" placeholder="https://example.com/image.jpg" />
    </div>
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
</form>
<script>
    (function () {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>
