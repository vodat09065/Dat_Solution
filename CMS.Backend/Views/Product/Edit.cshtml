@model CMS.Data.Entities.Product
@{
    ViewData["Title"] = "Sửa sản phẩm";
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<h2 class="mt-4">Sửa sản phẩm</h2>
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label class="form-label">Tên</label>
        <input class="form-control" asp-for="Name" />
    </div>
    <div class="mb-3">
        <label class="form-label">Mô tả</label>
        <textarea class="form-control" asp-for="Description"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Giá</label>
        <input class="form-control" asp-for="Price" type="number" step="0.01" />
    </div>
    <div class="mb-3">
        <label class="form-label">Số lượng</label>
        <input class="form-control" asp-for="StockQuantity" type="number" />
    </div>
    <div class="mb-3">
        <label class="form-label">Danh mục</label>
        <select class="form-select" asp-for="CategoryProductId" asp-items="ViewBag.CategoryProductList"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Ảnh</label>
        <input class="form-control" type="file" name="uploadImage" />
        @if (!string.IsNullOrEmpty(Model.ImageUrl)) {
            <p>Ảnh hiện tại: <img src="@Model.ImageUrl" style="height:80px;" /></p>
        }
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
