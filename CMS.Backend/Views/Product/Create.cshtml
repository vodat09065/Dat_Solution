@model CMS.Data.Entities.Product
@{
    ViewData["Title"] = "Thêm mới sản phẩm";
    Layout = "_LayoutAdmin";
}
<h2 class="mt-4 mb-3">Thêm mới sản phẩm</h2>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
    <div class="mb-3">
        <label class="form-label">Tên sản phẩm</label>
        <input class="form-control" asp-for="Name" required />
        <div class="invalid-feedback">Vui lòng nhập tên sản phẩm.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Mô tả</label>
        <textarea class="form-control" asp-for="Description" rows="3"></textarea>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Giá (VND)</label>
            <input class="form-control" asp-for="Price" type="number" step="1000" min="0" required />
            <div class="invalid-feedback">Vui lòng nhập giá sản phẩm.</div>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Số lượng tồn kho</label>
            <input class="form-control" asp-for="StockQuantity" type="number" min="0" required />
            <div class="invalid-feedback">Vui lòng nhập số lượng.</div>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Danh mục sản phẩm</label>
        <select class="form-select" asp-for="CategoryProductId" asp-items="ViewBag.CategoryProductList" required>
            <option value="">-- Chọn danh mục --</option>
        </select>
        <div class="invalid-feedback">Vui lòng chọn danh mục.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Hình ảnh sản phẩm</label>
        <input class="form-control" type="file" name="uploadImage" accept="image/*" />
        <div class="form-text">Hoặc nhập URL hình ảnh trực tiếp bên dưới:</div>
        <input class="form-control mt-2" asp-for="ImageUrl" placeholder="https://example.com/image.jpg" />
    </div>
    <button type="submit" class="btn btn-success">Lưu sản phẩm</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
</form>
<script>
    (function () {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>
