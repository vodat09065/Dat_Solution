@model IEnumerable<CMS.Data.Entities.User>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "User Management";
}
<h2 class="mt-4 mb-3">User List</h2>
<a class="btn btn-success mb-3" asp-action="Create">Add New User</a>
<table class="table table-hover table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Full Name</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.Id</td>
            <td>@item.Username</td>
            <td>@item.FullName</td>
            <td>@item.Role</td>
            <td>
                <a class="btn btn-sm btn-primary me-1" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id" onclick="return confirm('Are you sure?');">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
