@model CMS.Data.Entities.User
@{
    ViewData["Title"] = "Edit User";
    Layout = "_LayoutAdmin";
}
<h2 class="mt-4 mb-3">Edit User</h2>
<form asp-action="Edit" method="post" class="needs-validation" novalidate>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label class="form-label" asp-for="Username">Username</label>
        <input class="form-control" asp-for="Username" required />
        <div class="invalid-feedback">Please enter a username.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">New Password</label>
        <input class="form-control" name="NewPassword" type="password" placeholder="Leave blank to keep existing password" />
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="FullName">Full Name</label>
        <input class="form-control" asp-for="FullName" required />
        <div class="invalid-feedback">Please enter the full name.</div>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Role">Role</label>
        <select class="form-select" asp-for="Role" required>
            <option value="">-- Select Role --</option>
            <option value="Admin">Admin</option>
            <option value="Editor">Editor</option>
            <option value="Moderator">Moderator</option>
            <option value="User">User</option>
        </select>
        <div class="invalid-feedback">Please select a role.</div>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
</form>
<script>
    (function () {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>
