@model CMS.Data.Entities.User
@{
    ViewData["Title"] = "Create User";
    Layout = "_LayoutAdmin";
}
<h2 class="mt-4 mb-3">Create User</h2>
<form asp-action="Create" method="post" class="needs-validation" novalidate>
    <div class="mb-3">
        <label class="form-label" asp-for="Username">Username</label>
        <input class="form-control" asp-for="Username" required />
        <div class="invalid-feedback">Please enter a username.</div>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="PasswordHash">Password</label>
        <input class="form-control" asp-for="PasswordHash" type="password" required />
        <div class="invalid-feedback">Please enter a password.</div>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="FullName">Full Name</label>
        <input class="form-control" asp-for="FullName" required />
        <div class="invalid-feedback">Please enter the full name.</div>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Role">Role</label>
        <input class="form-control" asp-for="Role" required />
        <div class="invalid-feedback">Please enter the role.</div>
    </div>
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
</form>
<script>
    (function () {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>
