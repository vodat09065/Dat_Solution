@model CMS.Data.Entities.Category
@{
    ViewData["Title"] = "Sửa Danh mục";
}
<h2>Sửa Danh mục</h2>

<form asp-action="Edit" enctype="multipart/form-data"> <!-- THÊM enctype -->
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="form-group">
            <label>Hình ảnh hiện tại</label><br/>
            <img src="@Model.ImageUrl" style="max-width: 200px; margin-bottom: 10px;" />
        </div>
    }
    
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    
    <div class="form-group"> <!-- UPLOAD ẢNH MỚI -->
        <label>Đổi ảnh mới (nếu có)</label>
        <input type="file" name="imageFile" class="form-control" accept="image/*" />
    </div>
    
    <div class="form-group mt-3">
        <input type="submit" value="Lưu" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</form>